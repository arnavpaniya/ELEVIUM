#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x102f1aa80 .scope module, "counter_tb" "counter_tb" 2 3;
 .timescale -9 -12;
v0x102f22f30_0 .var "clk", 0 0;
v0x102f22fd0_0 .net "count", 3 0, v0x102f181a0_0;  1 drivers
v0x102f23070_0 .var "enable", 0 0;
v0x102f24210_0 .var/i "errors", 31 0;
v0x102f242b0_0 .var "reset", 0 0;
S_0x102f18020 .scope module, "uut" "counter" 2 15, 3 1 0, S_0x102f1aa80;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "enable";
    .port_info 3 /OUTPUT 4 "count";
P_0x7620c183c0 .param/l "WIDTH" 0 3 2, +C4<00000000000000000000000000000100>;
v0x102f1ac00_0 .net "clk", 0 0, v0x102f22f30_0;  1 drivers
v0x102f181a0_0 .var "count", 3 0;
v0x102f18240_0 .net "enable", 0 0, v0x102f23070_0;  1 drivers
v0x102f22e90_0 .net "reset", 0 0, v0x102f242b0_0;  1 drivers
E_0x7620c18400 .event posedge, v0x102f1ac00_0;
    .scope S_0x102f18020;
T_0 ;
    %wait E_0x7620c18400;
    %load/vec4 v0x102f22e90_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x102f181a0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x102f18240_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x102f181a0_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x102f181a0_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x102f1aa80;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x102f22f30_0;
    %inv;
    %store/vec4 v0x102f22f30_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x102f1aa80;
T_2 ;
    %vpi_call 2 26 "$dumpfile", "sim/waves/counter.vcd" {0 0 0};
    %vpi_call 2 27 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x102f1aa80 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102f22f30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x102f242b0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102f23070_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x102f24210_0, 0, 32;
    %wait E_0x7620c18400;
    %delay 1000, 0;
    %load/vec4 v0x102f22fd0_0;
    %cmpi/ne 0, 0, 4;
    %jmp/0xz  T_2.0, 6;
    %vpi_call 2 39 "$display", "ERROR: Counter did not reset" {0 0 0};
    %load/vec4 v0x102f24210_0;
    %addi 1, 0, 32;
    %store/vec4 v0x102f24210_0, 0, 32;
T_2.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102f242b0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x102f23070_0, 0, 1;
    %pushi/vec4 5, 0, 32;
T_2.2 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_2.3, 5;
    %jmp/1 T_2.3, 4;
    %subi 1, 0, 32;
    %wait E_0x7620c18400;
    %delay 1000, 0;
    %jmp T_2.2;
T_2.3 ;
    %pop/vec4 1;
    %load/vec4 v0x102f22fd0_0;
    %cmpi/ne 5, 0, 4;
    %jmp/0xz  T_2.4, 6;
    %vpi_call 2 54 "$display", "ERROR: Expected count=5, Got=%0d", v0x102f22fd0_0 {0 0 0};
    %load/vec4 v0x102f24210_0;
    %addi 1, 0, 32;
    %store/vec4 v0x102f24210_0, 0, 32;
    %jmp T_2.5;
T_2.4 ;
    %vpi_call 2 58 "$display", "PASS: Counter reached 5" {0 0 0};
T_2.5 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102f23070_0, 0, 1;
    %wait E_0x7620c18400;
    %delay 1000, 0;
    %load/vec4 v0x102f22fd0_0;
    %cmpi/ne 5, 0, 4;
    %jmp/0xz  T_2.6, 6;
    %vpi_call 2 68 "$display", "ERROR: Counter changed while disabled" {0 0 0};
    %load/vec4 v0x102f24210_0;
    %addi 1, 0, 32;
    %store/vec4 v0x102f24210_0, 0, 32;
    %jmp T_2.7;
T_2.6 ;
    %vpi_call 2 72 "$display", "PASS: Counter held value when disabled" {0 0 0};
T_2.7 ;
    %load/vec4 v0x102f24210_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.8, 4;
    %vpi_call 2 77 "$display", "--------------------------------" {0 0 0};
    %vpi_call 2 78 "$display", "COUNTER TEST PASSED" {0 0 0};
    %vpi_call 2 79 "$display", "--------------------------------" {0 0 0};
    %jmp T_2.9;
T_2.8 ;
    %vpi_call 2 82 "$display", "--------------------------------" {0 0 0};
    %vpi_call 2 83 "$display", "COUNTER TEST FAILED: %0d errors", v0x102f24210_0 {0 0 0};
    %vpi_call 2 84 "$display", "--------------------------------" {0 0 0};
T_2.9 ;
    %vpi_call 2 87 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/counter_tb.v";
    "rtl/counter.v";
