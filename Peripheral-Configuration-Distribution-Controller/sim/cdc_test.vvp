#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x1014c2e20 .scope module, "cdc_tb" "cdc_tb" 2 3;
 .timescale -9 -12;
v0x1014c00f0_0 .var "async_in", 0 0;
v0x1014c0190_0 .var "clk", 0 0;
v0x1014c0230_0 .var/i "errors", 31 0;
v0x1014cb050_0 .var "reset", 0 0;
v0x1014cb0f0_0 .net "sync_out", 0 0, v0x1014c0050_0;  1 drivers
S_0x1014c2fa0 .scope module, "uut" "cdc" 2 13, 3 1 0, S_0x1014c2e20;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "async_in";
    .port_info 3 /OUTPUT 1 "sync_out";
v0x1014c98f0_0 .net "async_in", 0 0, v0x1014c00f0_0;  1 drivers
v0x1014ca2b0_0 .net "clk", 0 0, v0x1014c0190_0;  1 drivers
v0x1014ca630_0 .net "reset", 0 0, v0x1014cb050_0;  1 drivers
v0x1014bffb0_0 .var "sync_ff1", 0 0;
v0x1014c0050_0 .var "sync_out", 0 0;
E_0x7b62c0c980 .event posedge, v0x1014ca2b0_0;
    .scope S_0x1014c2fa0;
T_0 ;
    %wait E_0x7b62c0c980;
    %load/vec4 v0x1014ca630_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x1014bffb0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x1014c0050_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x1014c98f0_0;
    %assign/vec4 v0x1014bffb0_0, 0;
    %load/vec4 v0x1014bffb0_0;
    %assign/vec4 v0x1014c0050_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x1014c2e20;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x1014c0190_0;
    %inv;
    %store/vec4 v0x1014c0190_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x1014c2e20;
T_2 ;
    %vpi_call 2 24 "$dumpfile", "sim/waves/cdc.vcd" {0 0 0};
    %vpi_call 2 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1014c2e20 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1014c0190_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1014cb050_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1014c00f0_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x1014c0230_0, 0, 32;
    %wait E_0x7b62c0c980;
    %delay 1000, 0;
    %load/vec4 v0x1014cb0f0_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_2.0, 6;
    %vpi_call 2 37 "$display", "ERROR: CDC output not reset" {0 0 0};
    %load/vec4 v0x1014c0230_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1014c0230_0, 0, 32;
T_2.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1014cb050_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1014c00f0_0, 0, 1;
    %wait E_0x7b62c0c980;
    %delay 1000, 0;
    %load/vec4 v0x1014cb0f0_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_2.2, 6;
    %vpi_call 2 51 "$display", "ERROR: CDC synchronized too early" {0 0 0};
    %load/vec4 v0x1014c0230_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1014c0230_0, 0, 32;
T_2.2 ;
    %wait E_0x7b62c0c980;
    %delay 1000, 0;
    %load/vec4 v0x1014cb0f0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_2.4, 6;
    %vpi_call 2 59 "$display", "ERROR: CDC failed to synchronize HIGH" {0 0 0};
    %load/vec4 v0x1014c0230_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1014c0230_0, 0, 32;
    %jmp T_2.5;
T_2.4 ;
    %vpi_call 2 63 "$display", "PASS: CDC synchronized HIGH" {0 0 0};
T_2.5 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1014c00f0_0, 0, 1;
    %wait E_0x7b62c0c980;
    %delay 1000, 0;
    %load/vec4 v0x1014cb0f0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_2.6, 6;
    %vpi_call 2 73 "$display", "ERROR: CDC changed too early" {0 0 0};
    %load/vec4 v0x1014c0230_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1014c0230_0, 0, 32;
T_2.6 ;
    %wait E_0x7b62c0c980;
    %delay 1000, 0;
    %load/vec4 v0x1014cb0f0_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_2.8, 6;
    %vpi_call 2 81 "$display", "ERROR: CDC failed to synchronize LOW" {0 0 0};
    %load/vec4 v0x1014c0230_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1014c0230_0, 0, 32;
    %jmp T_2.9;
T_2.8 ;
    %vpi_call 2 85 "$display", "PASS: CDC synchronized LOW" {0 0 0};
T_2.9 ;
    %load/vec4 v0x1014c0230_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.10, 4;
    %vpi_call 2 90 "$display", "--------------------------------" {0 0 0};
    %vpi_call 2 91 "$display", "CDC TEST PASSED" {0 0 0};
    %vpi_call 2 92 "$display", "--------------------------------" {0 0 0};
    %jmp T_2.11;
T_2.10 ;
    %vpi_call 2 95 "$display", "--------------------------------" {0 0 0};
    %vpi_call 2 96 "$display", "CDC TEST FAILED: %0d errors", v0x1014c0230_0 {0 0 0};
    %vpi_call 2 97 "$display", "--------------------------------" {0 0 0};
T_2.11 ;
    %vpi_call 2 100 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/cdc_tb.v";
    "rtl/cdc.v";
