:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x1012b7e30 .scope module, "sipo_tb" "sipo_tb" 2 3;
 .timescale -9 -12;
v0x1012bfcf0_0 .var "clk", 0 0;
v0x1012bfd90_0 .var "enable", 0 0;
v0x1012c0690_0 .var/i "errors", 31 0;
v0x1012c0730_0 .var/i "i", 31 0;
v0x7973078000_0 .net "parallel_out", 7 0, v0x1012b4180_0;  1 drivers
v0x79730780a0_0 .var "reset", 0 0;
v0x7973078140_0 .var "serial_in", 0 0;
v0x79730781e0_0 .var "test_data", 7 0;
v0x7973078280_0 .net "valid", 0 0, v0x1012bfc50_0;  1 drivers
S_0x1012b7fb0 .scope module, "uut" "sipo" 2 18, 3 1 0, S_0x1012b7e30;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "enable";
    .port_info 3 /INPUT 1 "serial_in";
    .port_info 4 /OUTPUT 8 "parallel_out";
    .port_info 5 /OUTPUT 1 "valid";
v0x1012b3fa0_0 .var "bit_count", 2 0;
v0x1012b4040_0 .net "clk", 0 0, v0x1012bfcf0_0;  1 drivers
v0x1012b40e0_0 .net "enable", 0 0, v0x1012bfd90_0;  1 drivers
v0x1012b4180_0 .var "parallel_out", 7 0;
v0x1012b4220_0 .net "reset", 0 0, v0x79730780a0_0;  1 drivers
v0x1012bfb10_0 .net "serial_in", 0 0, v0x7973078140_0;  1 drivers
v0x1012bfbb0_0 .var "shift_reg", 7 0;
v0x1012bfc50_0 .var "valid", 0 0;
E_0x7972c1c740 .event posedge, v0x1012b4040_0;
    .scope S_0x1012b7fb0;
T_0 ;
    %wait E_0x7972c1c740;
    %load/vec4 v0x1012b4220_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x1012bfbb0_0, 0;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x1012b4180_0, 0;
    %pushi/vec4 0, 0, 3;
    %assign/vec4 v0x1012b3fa0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x1012bfc50_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x1012bfc50_0, 0;
    %load/vec4 v0x1012b40e0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x1012b3fa0_0;
    %cmpi/u 7, 0, 3;
    %jmp/0xz  T_0.4, 5;
    %load/vec4 v0x1012bfb10_0;
    %load/vec4 v0x1012bfbb0_0;
    %parti/s 7, 1, 2;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x1012bfbb0_0, 0;
    %load/vec4 v0x1012b3fa0_0;
    %addi 1, 0, 3;
    %assign/vec4 v0x1012b3fa0_0, 0;
    %jmp T_0.5;
T_0.4 ;
    %load/vec4 v0x1012bfb10_0;
    %load/vec4 v0x1012bfbb0_0;
    %parti/s 7, 1, 2;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x1012bfbb0_0, 0;
    %load/vec4 v0x1012bfb10_0;
    %load/vec4 v0x1012bfbb0_0;
    %parti/s 7, 1, 2;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x1012b4180_0, 0;
    %pushi/vec4 0, 0, 3;
    %assign/vec4 v0x1012b3fa0_0, 0;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x1012bfc50_0, 0;
T_0.5 ;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x1012b7e30;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x1012bfcf0_0;
    %inv;
    %store/vec4 v0x1012bfcf0_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x1012b7e30;
T_2 ;
    %vpi_call 2 32 "$dumpfile", "sim/waves/sipo.vcd" {0 0 0};
    %vpi_call 2 33 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1012b7e30 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x1012c0690_0, 0, 32;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1012bfcf0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x79730780a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1012bfd90_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x7973078140_0, 0, 1;
    %wait E_0x7972c1c740;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x79730780a0_0, 0, 1;
    %pushi/vec4 178, 0, 8;
    %store/vec4 v0x79730781e0_0, 0, 8;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1012bfd90_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x1012c0730_0, 0, 32;
T_2.0 ; Top of for-loop
    %load/vec4 v0x1012c0730_0;
    %cmpi/s 8, 0, 32;
	  %jmp/0xz T_2.1, 5;
    %load/vec4 v0x79730781e0_0;
    %load/vec4 v0x1012c0730_0;
    %part/s 1;
    %store/vec4 v0x7973078140_0, 0, 1;
    %wait E_0x7972c1c740;
    %delay 1000, 0;
T_2.2 ; for-loop step statement
    %load/vec4 v0x1012c0730_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1012c0730_0, 0, 32;
    %jmp T_2.0;
T_2.1 ; for-loop exit label
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1012bfd90_0, 0, 1;
    %load/vec4 v0x7973078000_0;
    %load/vec4 v0x79730781e0_0;
    %cmp/ne;
    %jmp/0xz  T_2.3, 6;
    %vpi_call 2 68 "$display", "ERROR: Expected=%b | Got=%b", v0x79730781e0_0, v0x7973078000_0 {0 0 0};
    %load/vec4 v0x1012c0690_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1012c0690_0, 0, 32;
    %jmp T_2.4;
T_2.3 ;
    %vpi_call 2 79 "$display", "PASS: SIPO received correct parallel data" {0 0 0};
T_2.4 ;
    %load/vec4 v0x7973078280_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_2.5, 6;
    %vpi_call 2 84 "$display", "ERROR: valid was not asserted" {0 0 0};
    %load/vec4 v0x1012c0690_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1012c0690_0, 0, 32;
    %jmp T_2.6;
T_2.5 ;
    %vpi_call 2 89 "$display", "PASS: valid asserted after 8 bits" {0 0 0};
T_2.6 ;
    %wait E_0x7972c1c740;
    %delay 1000, 0;
    %load/vec4 v0x7973078280_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_2.7, 6;
    %vpi_call 2 96 "$display", "ERROR: valid did not return low" {0 0 0};
    %load/vec4 v0x1012c0690_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1012c0690_0, 0, 32;
T_2.7 ;
    %load/vec4 v0x1012c0690_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.9, 4;
    %vpi_call 2 102 "$display", "--------------------------------" {0 0 0};
    %vpi_call 2 103 "$display", "SIPO TEST PASSED" {0 0 0};
    %vpi_call 2 104 "$display", "--------------------------------" {0 0 0};
    %jmp T_2.10;
T_2.9 ;
    %vpi_call 2 107 "$display", "--------------------------------" {0 0 0};
    %vpi_call 2 108 "$display", "SIPO TEST FAILED: %0d errors", v0x1012c0690_0 {0 0 0};
    %vpi_call 2 109 "$display", "--------------------------------" {0 0 0};
T_2.10 ;
    %vpi_call 2 112 "$finish" {0 0 0};
    %end;
    .thread T_2;
