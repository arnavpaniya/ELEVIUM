T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x102caa660;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x102cb0770_0;
    %inv;
    %store/vec4 v0x102cb0770_0, 0, 1;
